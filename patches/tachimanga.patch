diff --git a/core/src/main/kotlin/keiyoushi/network/TooManyRequests.kt b/core/src/main/kotlin/keiyoushi/network/TooManyRequests.kt
new file mode 100644
index 00000000..0ee51199
--- /dev/null
+++ b/core/src/main/kotlin/keiyoushi/network/TooManyRequests.kt
@@ -0,0 +1,54 @@
+package keiyoushi.network
+
+import okhttp3.Interceptor
+import okhttp3.OkHttpClient
+import okhttp3.Response
+import java.io.IOException
+import kotlin.time.Duration
+import kotlin.time.Duration.Companion.seconds
+
+/**
+ * Retries a request the server answered with HTTP 429.
+ *
+ * A rate limit rule only paces the requests a source issues itself: redirects are followed
+ * below it and the app fetches details and chapters in parallel, so a burst can still reach
+ * the server faster than it accepts. Without this the user sees a hard error on a page that
+ * loads fine in the WebView moments later.
+ *
+ * @param maxRetries Attempts after the first response.
+ * @param backoff    Base wait, multiplied by the attempt number. A `Retry-After` header takes
+ *                   precedence, capped by [MAX_WAIT] so a hostile value cannot hang the app.
+ */
+fun OkHttpClient.Builder.retryOnTooManyRequests(
+    maxRetries: Int = 3,
+    backoff: Duration = 2.seconds,
+): OkHttpClient.Builder = addInterceptor(TooManyRequestsInterceptor(maxRetries, backoff))
+
+internal class TooManyRequestsInterceptor(
+    private val maxRetries: Int,
+    private val backoff: Duration,
+) : Interceptor {
+
+    override fun intercept(chain: Interceptor.Chain): Response {
+        var response = chain.proceed(chain.request())
+        var attempt = 0
+
+        while (response.code == HTTP_TOO_MANY_REQUESTS && attempt < maxRetries) {
+            if (chain.call().isCanceled()) throw IOException("Canceled")
+            val wait = response.retryAfter() ?: backoff * (attempt + 1)
+            response.close()
+            Thread.sleep(wait.coerceAtMost(MAX_WAIT).inWholeMilliseconds)
+            attempt++
+            response = chain.proceed(chain.request())
+        }
+
+        return response
+    }
+
+    private fun Response.retryAfter(): Duration? = header("Retry-After")?.toLongOrNull()?.seconds
+
+    companion object {
+        private const val HTTP_TOO_MANY_REQUESTS = 429
+        private val MAX_WAIT = 30.seconds
+    }
+}
